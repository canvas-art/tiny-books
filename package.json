{
  "name": "tiny-books",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "wrangler d1 migrations apply tiny-books --local",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "seed:gen": "python3 -I scripts/parse_book.py data/meditations.txt data/sections.json && python3 -I scripts/split_micro.py data/sections.json data/micros.json && python3 -I scripts/gen_seed.py",
    "db:migrate:local": "wrangler d1 migrations apply tiny-books --local",
    "db:migrate:remote": "wrangler d1 migrations apply tiny-books --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply tiny-books --local",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
