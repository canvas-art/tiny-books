{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tiny-books",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-20",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tiny-books",
			"database_id": "831feab9-90cb-4ccb-b1d8-a962ffa566e9",
			"migrations_dir": "migrations",
			// `pnpm dev` uses a local SQLite copy in .wrangler/state, never the Cloudflare database.
			"remote": false
		}
	],
	// Per-IP limits. namespace_id only has to be a unique number within the account.
	"ratelimits": [
		{ "name": "RATE_READ", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
		{ "name": "RATE_WRITE", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } },
		{ "name": "RATE_ACCESS", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
	],
	"observability": {
		"enabled": true
	}
}